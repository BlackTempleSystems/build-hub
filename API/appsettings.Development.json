{
    "FrontendApplicationSettings": {
        "BaseUrl": "http://localhost:4200"
    },
    "DatabaseConfigurations": [
        {
            "DatabaseSource": "Users",
            "MaxPoolConnections": 10,
            "MinPoolConnections": 5,
            "RetrieveConnectionRetryCount": 3
        },
        {
            "DatabaseSource": "Core",
            "MaxPoolConnections": 10,
            "MinPoolConnections": 5,
            "RetrieveConnectionRetryCount": 3
        },
        {
            "DatabaseSource": "IntegrationTests",
            "MaxPoolConnections": 10,
            "MinPoolConnections": 5,
            "RetrieveConnectionRetryCount": 3
        }
    ],

    "LoggerConfiguration": {
        "MinimumLogEventLevelLogLevel": "Debug",
        "LogFileDirectory": "./Logs/Log-.log",
        "RollingInterval": "Hour",
        "SeqServerUrl": "http://localhost:5341/",
        "LogToConsoleEnabled": true
    },

    "Jwt": {
        "Issuer": "BuildHub.Api",
        "Audience": "BuildHub.Client",
        "Key": "PUT_A_LONG_RANDOM_32+_CHAR_SECRET_HERE", // Should store it in Infisical or Environment Variables
        "AccessTokenMinutes": 20,
        "RefreshTokenDays": 14
    },
    "AllowedHosts": "*"
}
